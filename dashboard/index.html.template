<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GroundLink — Flight Replay</title>
<style>
/* ==========================================================================
   GroundLink flight replay
   Visual language borrowed from avionics navigation displays: magenta is the
   active flight-plan leg (as on every real GPS navigator), amber is the
   original planned route, red is restricted airspace. Dashed = a plan,
   solid = actually flown. Day/Night are the two modes a real cockpit
   display ships with, so both themes are first-class here.
   ========================================================================== */

:root{
  color-scheme: dark;
  /* neutrals: blue-biased, chosen rather than inherited */
  --ground:#0A0F16;
  --ground-2:#070B11;
  --surface:#111927;
  --surface-2:#161F2E;
  --rule:#1D2736;
  --rule-soft:#161E2B;
  --ink:#E6ECF5;
  --ink-2:#8494AB;
  --ink-3:#5A6880;
  /* signal colours */
  --active:#FF3D88;      /* flown / active leg */
  --active-soft:rgba(255,61,136,.16);
  --planned:#E0A93C;     /* original planned route, caution */
  --planned-soft:rgba(224,169,60,.15);
  --alert:#FF5B5B;       /* restricted airspace */
  --alert-soft:rgba(255,91,91,.13);
  --ok:#35D08A;
  /* map surface */
  --map-bg:#080C13;
  --map-grid:#131C2A;
  --map-ring:#1A2536;
  --map-ring-ink:#3C4A60;

  --mono: ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;

  --r-lg:10px; --r-md:7px; --r-sm:5px;
  --pad:20px;
}

@media (prefers-color-scheme: light){
  :root{
    color-scheme: light;
    --ground:#E9EDF2; --ground-2:#DFE5ED;
    --surface:#FFFFFF; --surface-2:#F4F7FA;
    --rule:#C9D2DE; --rule-soft:#DCE3EC;
    --ink:#0E1620; --ink-2:#55637A; --ink-3:#7B889C;
    --active:#D6206B; --active-soft:rgba(214,32,107,.12);
    --planned:#A9761A; --planned-soft:rgba(169,118,26,.14);
    --alert:#D62828; --alert-soft:rgba(214,40,40,.10);
    --ok:#127A49;
    --map-bg:#F2F5F9; --map-grid:#DDE4EE; --map-ring:#CBD5E2; --map-ring-ink:#94A3B8;
  }
}
:root[data-theme="light"]{
  color-scheme: light;
  --ground:#E9EDF2; --ground-2:#DFE5ED;
  --surface:#FFFFFF; --surface-2:#F4F7FA;
  --rule:#C9D2DE; --rule-soft:#DCE3EC;
  --ink:#0E1620; --ink-2:#55637A; --ink-3:#7B889C;
  --active:#D6206B; --active-soft:rgba(214,32,107,.12);
  --planned:#A9761A; --planned-soft:rgba(169,118,26,.14);
  --alert:#D62828; --alert-soft:rgba(214,40,40,.10);
  --ok:#127A49;
  --map-bg:#F2F5F9; --map-grid:#DDE4EE; --map-ring:#CBD5E2; --map-ring-ink:#94A3B8;
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --ground:#0A0F16; --ground-2:#070B11;
  --surface:#111927; --surface-2:#161F2E;
  --rule:#1D2736; --rule-soft:#161E2B;
  --ink:#E6ECF5; --ink-2:#8494AB; --ink-3:#5A6880;
  --active:#FF3D88; --active-soft:rgba(255,61,136,.16);
  --planned:#E0A93C; --planned-soft:rgba(224,169,60,.15);
  --alert:#FF5B5B; --alert-soft:rgba(255,91,91,.13);
  --ok:#35D08A;
  --map-bg:#080C13; --map-grid:#131C2A; --map-ring:#1A2536; --map-ring-ink:#3C4A60;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--ground);
  color:var(--ink);
  font-family:var(--sans);
  font-size:14px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--active); color:#fff;}
:focus-visible{ outline:2px solid var(--active); outline-offset:2px; border-radius:3px; }

.shell{ max-width:1440px; margin:0 auto; padding:0 26px 56px; }

/* ---------- header ---------------------------------------------------- */
.masthead{
  display:flex; align-items:center; justify-content:space-between; gap:20px;
  padding:18px 0 16px; border-bottom:1px solid var(--rule);
  flex-wrap:wrap;
}
.ident{ display:flex; align-items:center; gap:12px; min-width:0; }
.ident-mark{
  width:30px; height:30px; flex:none; border-radius:var(--r-sm);
  border:1px solid var(--rule); background:var(--surface);
  display:grid; place-items:center;
}
.ident-mark svg{ width:17px; height:17px; display:block; }
.ident-text h1{
  margin:0; font-family:var(--mono); font-size:15px; font-weight:600;
  letter-spacing:.14em; text-transform:uppercase;
}
.ident-text p{ margin:1px 0 0; font-size:11.5px; color:var(--ink-2); }
.masthead-tools{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.chip{
  font-family:var(--mono); font-size:10.5px; letter-spacing:.07em; text-transform:uppercase;
  color:var(--ink-2); border:1px solid var(--rule); border-radius:100px;
  padding:5px 11px; display:inline-flex; align-items:center; gap:7px; white-space:nowrap;
}
.chip .live{ width:5px; height:5px; border-radius:50%; background:var(--ok); }
.mode-toggle{
  display:flex; border:1px solid var(--rule); border-radius:100px; overflow:hidden; background:var(--surface);
}
.mode-toggle button{
  appearance:none; border:0; background:transparent; cursor:pointer;
  font-family:var(--mono); font-size:10.5px; letter-spacing:.09em; text-transform:uppercase;
  color:var(--ink-3); padding:5px 11px; transition:color .16s, background .16s;
}
.mode-toggle button[aria-pressed="true"]{ background:var(--ink); color:var(--ground); }

/* ---------- scenario selector ------------------------------------------ */
.selector{
  position:relative;                 /* keeps the sliding indicator anchored here */
  display:flex; gap:2px; margin:18px 0 16px;
  border:1px solid var(--rule); border-radius:var(--r-md); padding:3px;
  background:var(--surface); width:fit-content; max-width:100%; overflow:hidden;
}
.sel-indicator{
  position:absolute; top:3px; bottom:3px; left:3px; width:0;
  background:var(--surface-2); border:1px solid var(--rule);
  border-radius:var(--r-sm); pointer-events:none; z-index:0;
  transition:left .28s cubic-bezier(.4,0,.2,1), width .28s cubic-bezier(.4,0,.2,1);
}
.sel-btn{
  position:relative; z-index:1; appearance:none; border:0; background:transparent; cursor:pointer;
  font-family:var(--mono); font-size:11.5px; letter-spacing:.07em; text-transform:uppercase;
  color:var(--ink-3); padding:8px 16px; white-space:nowrap; transition:color .2s;
}
.sel-btn[aria-selected="true"]{ color:var(--ink); }
.sel-btn:hover{ color:var(--ink-2); }

/* ---------- verdict band (largest type on the page) --------------------- */
.verdict{
  border:1px solid var(--rule); border-radius:var(--r-lg); background:var(--surface);
  padding:18px var(--pad); margin-bottom:16px;
  display:grid; grid-template-columns:minmax(0,1fr) auto; gap:24px; align-items:center;
}
@media (max-width:860px){ .verdict{ grid-template-columns:1fr; } }
.verdict-eyebrow{
  font-family:var(--mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase;
  color:var(--ink-3); margin-bottom:7px;
}
.verdict-metric{ font-size:16px; font-weight:600; letter-spacing:-.01em; margin-bottom:5px; }
.verdict-foot{ font-size:12px; color:var(--ink-2); max-width:62ch; }
.verdict-figures{ display:flex; align-items:flex-end; gap:20px; }
.figure{ text-align:right; }
.figure .fv{
  font-family:var(--mono); font-size:clamp(30px,4.4vw,50px); font-weight:600;
  line-height:.92; letter-spacing:-.03em; font-variant-numeric:tabular-nums; display:block;
}
.figure.adaptive .fv{ color:var(--active); }
.figure.baseline .fv{ color:var(--ink-3); }
.figure .fk{
  font-family:var(--mono); font-size:9.5px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--ink-3); margin-top:9px; display:block;
}
.figure-vs{
  font-family:var(--mono); font-size:11px; color:var(--ink-3); padding-bottom:14px;
  letter-spacing:.1em; text-transform:uppercase;
}
.delta{
  font-family:var(--mono); font-size:11px; letter-spacing:.03em;
  color:var(--active); border:1px solid var(--active); background:var(--active-soft);
  border-radius:100px; padding:6px 13px; white-space:nowrap; align-self:center;
}

/* ---------- working area ------------------------------------------------ */
.work{ display:grid; grid-template-columns:minmax(0,1fr) 330px; gap:16px; align-items:start; }
@media (max-width:1080px){ .work{ grid-template-columns:1fr; } }

.panel{ border:1px solid var(--rule); border-radius:var(--r-lg); background:var(--surface); overflow:hidden; }
.panel-head{
  display:flex; align-items:center; justify-content:space-between; gap:12px;
  padding:12px var(--pad); border-bottom:1px solid var(--rule-soft);
}
.panel-title{
  font-family:var(--mono); font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
  color:var(--ink-2); margin:0; font-weight:500;
}
.panel-note{ font-family:var(--mono); font-size:10.5px; color:var(--ink-3); font-variant-numeric:tabular-nums; }

/* map */
.map-frame{ background:var(--map-bg); border-bottom:1px solid var(--rule-soft); }
svg.chart{ display:block; width:100%; height:auto; }

/* layer toggles */
.layers{ display:flex; gap:6px; padding:11px var(--pad); border-bottom:1px solid var(--rule-soft); flex-wrap:wrap; }
.layer{
  appearance:none; cursor:pointer; background:transparent;
  border:1px solid var(--rule); border-radius:100px; padding:5px 11px;
  font-family:var(--mono); font-size:10px; letter-spacing:.08em; text-transform:uppercase;
  color:var(--ink-3); display:inline-flex; align-items:center; gap:7px;
  transition:color .16s, border-color .16s, background .16s;
}
.layer .key{ width:14px; height:0; border-top-width:2px; border-top-style:dashed; border-color:currentColor; flex:none; }
.layer .key.solid{ border-top-style:solid; }
.layer .key.box{ height:9px; width:9px; border:1px solid currentColor; border-radius:2px; }
.layer[aria-pressed="true"]{ color:var(--ink); border-color:var(--ink-3); }
.layer[aria-pressed="false"]{ opacity:.5; }

/* transport */
.transport{ display:flex; align-items:center; gap:14px; padding:13px var(--pad); flex-wrap:wrap; }
.tp-btn{
  width:34px; height:34px; flex:none; border-radius:50%; cursor:pointer;
  border:1px solid var(--rule); background:var(--surface-2); color:var(--ink);
  display:grid; place-items:center; transition:border-color .16s, background .16s;
}
.tp-btn:hover{ border-color:var(--ink-3); }
.tp-btn svg{ width:13px; height:13px; display:block; }
.scrub{ flex:1 1 220px; min-width:160px; padding:9px 0; cursor:pointer; touch-action:none; }
.scrub-track{ position:relative; height:3px; border-radius:2px; background:var(--rule); }
.scrub-fill{ position:absolute; inset:0 auto 0 0; width:0; border-radius:2px; background:var(--active); }
.scrub-tick{
  position:absolute; top:-4px; width:2px; height:11px; border-radius:1px;
  background:var(--planned); transform:translateX(-1px);
}
.scrub-thumb{
  position:absolute; top:50%; width:13px; height:13px; border-radius:50%;
  background:var(--active); border:2px solid var(--surface);
  transform:translate(-50%,-50%); pointer-events:none;
  box-shadow:0 0 0 1px var(--active);
}
.tp-time{
  font-family:var(--mono); font-size:11.5px; color:var(--ink-2);
  font-variant-numeric:tabular-nums; white-space:nowrap;
}
.tp-speeds{ display:flex; gap:3px; }
.tp-speed{
  appearance:none; cursor:pointer; background:transparent; border:1px solid var(--rule);
  border-radius:var(--r-sm); padding:4px 8px; color:var(--ink-3);
  font-family:var(--mono); font-size:10px; font-variant-numeric:tabular-nums;
  transition:color .16s, border-color .16s, background .16s;
}
.tp-speed[aria-pressed="true"]{ color:var(--ground); background:var(--ink); border-color:var(--ink); }

/* readouts */
.readouts{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-top:1px solid var(--rule-soft); }
.readout{ padding:12px var(--pad); border-left:1px solid var(--rule-soft); }
.readout:first-child{ border-left:0; }
.readout .rk{
  font-family:var(--mono); font-size:9.5px; letter-spacing:.13em; text-transform:uppercase;
  color:var(--ink-3); margin-bottom:5px;
}
.readout .rv{
  font-family:var(--mono); font-size:15px; font-weight:600; font-variant-numeric:tabular-nums;
  letter-spacing:-.01em;
}
.rv[data-mode="HOLD"]{ color:var(--planned); }
.rv[data-mode="RETURN_TO_LAUNCH"], .rv[data-mode="LAND"]{ color:var(--active); }
.rv[data-state="replanning"]{ color:var(--active); }

/* right rail */
.rail{ display:flex; flex-direction:column; gap:16px; }
.brief{ padding:15px var(--pad); font-size:13px; line-height:1.6; color:var(--ink-2); }
.brief strong{ color:var(--ink); font-weight:600; }

.timeline{ padding:6px var(--pad) 15px; }
.tl-item{ display:grid; grid-template-columns:46px 13px minmax(0,1fr); gap:10px; align-items:start; }
.tl-time{
  font-family:var(--mono); font-size:10.5px; color:var(--ink-3);
  font-variant-numeric:tabular-nums; padding-top:9px;
}
.tl-rail{ display:flex; flex-direction:column; align-items:center; height:100%; }
.tl-node{
  width:7px; height:7px; border-radius:50%; margin-top:12px; flex:none;
  background:var(--rule); border:1px solid var(--rule);
}
.tl-line{ width:1px; flex:1 1 auto; background:var(--rule-soft); min-height:12px; }
.tl-text{ font-size:12.5px; color:var(--ink-3); padding:8px 0 10px; line-height:1.45; }
.tl-text strong{ font-weight:600; }
.tl-item[data-state="reached"] .tl-node{ background:var(--ink-3); border-color:var(--ink-3); }
.tl-item[data-state="reached"] .tl-text{ color:var(--ink-2); }
.tl-item[data-state="current"] .tl-time{ color:var(--active); }
.tl-item[data-state="current"] .tl-text{ color:var(--ink); }
.tl-item[data-state="current"] .tl-node{ background:var(--active); border-color:var(--active); box-shadow:0 0 0 3px var(--active-soft); }
.tl-item[data-kind="trigger"][data-state="current"] .tl-node,
.tl-item[data-kind="trigger"][data-state="reached"] .tl-node{ background:var(--planned); border-color:var(--planned); }
.tl-item[data-kind="trigger"][data-state="current"] .tl-node{ box-shadow:0 0 0 3px var(--planned-soft); }
.tl-item[data-kind="trigger"][data-state="current"] .tl-time{ color:var(--planned); }

/* ---------- comparison matrix ------------------------------------------ */
.matrix{ margin-top:16px; }
.matrix-scroll{ overflow-x:auto; }
table.cmp{ width:100%; border-collapse:collapse; min-width:660px; }
table.cmp th, table.cmp td{ text-align:left; padding:11px var(--pad); border-top:1px solid var(--rule-soft); }
table.cmp thead th{
  border-top:0; font-family:var(--mono); font-size:9.5px; letter-spacing:.13em;
  text-transform:uppercase; color:var(--ink-3); font-weight:500; padding-top:13px; padding-bottom:9px;
}
table.cmp tbody tr:hover{ background:var(--surface-2); }
.cmp-scenario{ font-size:12.5px; color:var(--ink); }
.cmp-cond{
  font-family:var(--mono); font-size:10px; letter-spacing:.09em; text-transform:uppercase;
}
.cmp-cond[data-c="adaptive"]{ color:var(--active); }
.cmp-cond[data-c="baseline"]{ color:var(--ink-3); }
.cmp-num{ font-family:var(--mono); font-size:12.5px; font-variant-numeric:tabular-nums; }
.cmp-bar{ display:flex; align-items:center; gap:9px; }
.cmp-bar-track{ flex:1 1 auto; height:5px; border-radius:3px; background:var(--rule); min-width:56px; overflow:hidden; }
.cmp-bar-fill{ height:100%; border-radius:3px; width:0; transition:width .8s cubic-bezier(.3,.8,.3,1); }
.cmp-bar-fill[data-c="adaptive"]{ background:var(--active); }
.cmp-bar-fill[data-c="baseline"]{ background:var(--ink-3); }

footer.colophon{
  margin-top:22px; padding-top:14px; border-top:1px solid var(--rule);
  display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap;
  font-family:var(--mono); font-size:10.5px; letter-spacing:.05em; color:var(--ink-3);
  text-transform:uppercase;
}

@keyframes ring{ from{ r:6; opacity:.85; } to{ r:19; opacity:0; } }
@media (prefers-reduced-motion: reduce){
  *{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; }
}
</style>
</head>
<body>
<div class="shell">

  <header class="masthead">
    <div class="ident">
      <div class="ident-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v18M3 12h18" opacity=".35"/>
          <path d="M12 4.5 18.5 19 12 15.4 5.5 19Z" fill="currentColor" fill-opacity=".14"/>
        </svg>
      </div>
      <div class="ident-text">
        <h1>GroundLink</h1>
        <p>Adaptive mission replanning &mdash; recorded flight replay</p>
      </div>
    </div>
    <div class="masthead-tools">
      <span class="chip"><span class="live"></span> PX4 SITL &mdash; recorded</span>
      <span class="chip">40 trials &middot; 8 conditions</span>
      <div class="mode-toggle" role="group" aria-label="Display mode">
        <button type="button" id="modeNight" aria-pressed="true">Night</button>
        <button type="button" id="modeDay" aria-pressed="false">Day</button>
      </div>
    </div>
  </header>

  <div class="selector" role="tablist" aria-label="Failure scenario" id="selector">
    <div class="sel-indicator" id="selIndicator" aria-hidden="true"></div>
  </div>

  <section class="verdict" aria-labelledby="verdictMetric">
    <div>
      <div class="verdict-eyebrow" id="verdictEyebrow">Measured outcome</div>
      <div class="verdict-metric" id="verdictMetric">&mdash;</div>
      <p class="verdict-foot" id="verdictFoot">&mdash;</p>
    </div>
    <div class="verdict-figures">
      <div class="figure adaptive">
        <span class="fv" id="figAdaptive">&mdash;</span>
        <span class="fk">GroundLink</span>
      </div>
      <div class="figure-vs">vs</div>
      <div class="figure baseline">
        <span class="fv" id="figBaseline">&mdash;</span>
        <span class="fk">Baseline RTL</span>
      </div>
      <div class="delta" id="verdictDelta">&mdash;</div>
    </div>
  </section>

  <div class="work">
    <div>
      <section class="panel">
        <div class="panel-head">
          <h2 class="panel-title" id="mapTitle">Flight track</h2>
          <span class="panel-note" id="mapNote">&mdash;</span>
        </div>
        <div class="map-frame">
          <svg class="chart" id="chart" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Recorded flight track"></svg>
        </div>
        <div class="layers">
          <button type="button" class="layer" data-layer="planned" aria-pressed="true"><span class="key" style="color:var(--planned)"></span> Planned route</button>
          <button type="button" class="layer" data-layer="flown" aria-pressed="true"><span class="key solid" style="color:var(--active)"></span> Flown track</button>
          <button type="button" class="layer" data-layer="zone" aria-pressed="true"><span class="key box" style="color:var(--alert)"></span> Restricted zone</button>
          <button type="button" class="layer" data-layer="rings" aria-pressed="true"><span class="key" style="color:var(--ink-3)"></span> Range rings</button>
        </div>
        <div class="transport">
          <button type="button" class="tp-btn" id="playBtn" aria-label="Play">
            <svg id="playIcon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <div class="scrub" id="scrub" role="slider" tabindex="0" aria-label="Flight time" aria-valuemin="0" aria-valuenow="0" aria-valuemax="0">
            <div class="scrub-track">
              <div class="scrub-fill" id="scrubFill"></div>
              <div class="scrub-tick" id="scrubTick" title="Replan trigger"></div>
              <div class="scrub-thumb" id="scrubThumb"></div>
            </div>
          </div>
          <div class="tp-time" id="tpTime">0.0 / 0.0 s</div>
          <div class="tp-speeds" role="group" aria-label="Playback speed" id="tpSpeeds"></div>
        </div>
        <div class="readouts">
          <div class="readout"><div class="rk">Altitude AGL</div><div class="rv" id="roAlt">&mdash;</div></div>
          <div class="readout"><div class="rk">Flight mode</div><div class="rv" id="roMode">&mdash;</div></div>
          <div class="readout"><div class="rk">Elapsed</div><div class="rv" id="roTime">&mdash;</div></div>
          <div class="readout"><div class="rk">Replan state</div><div class="rv" id="roState">&mdash;</div></div>
        </div>
      </section>
    </div>

    <aside class="rail">
      <section class="panel">
        <div class="panel-head"><h2 class="panel-title">What happens</h2></div>
        <div class="brief" id="brief">&mdash;</div>
      </section>
      <section class="panel">
        <div class="panel-head"><h2 class="panel-title">Sequence</h2></div>
        <div class="timeline" id="timeline"></div>
      </section>
    </aside>
  </div>

  <section class="panel matrix">
    <div class="panel-head">
      <h2 class="panel-title">All scenarios &mdash; adaptive vs baseline</h2>
      <span class="panel-note">5 trials per condition</span>
    </div>
    <div class="matrix-scroll">
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col">Scenario</th>
            <th scope="col">Condition</th>
            <th scope="col">Mission completion</th>
            <th scope="col">Time to safe recovery</th>
            <th scope="col">Safe recoveries</th>
          </tr>
        </thead>
        <tbody id="cmpBody"></tbody>
      </table>
    </div>
  </section>

  <footer class="colophon">
    <span>GroundLink &middot; Team 11 &middot; Autonomous Drones</span>
    <span>Replay of recorded PX4 SITL telemetry &mdash; no live vehicle connection</span>
  </footer>
</div>

<script>
"use strict";
const DATA = __FLIGHT_DATA__;

/* ---- geo: equirectangular local metres, matching mission_planner/geo.py -- */
const R_EARTH = 6371000;
function localXY(lat, lon, oLat, oLon){
  return [
    (lon - oLon) * Math.PI/180 * R_EARTH * Math.cos(oLat * Math.PI/180),
    (lat - oLat) * Math.PI/180 * R_EARTH
  ];
}

/* ---- scenario copy + headline metrics (all figures from evaluation/RESULTS.md) */
const SCENARIOS = [
  {
    key:'no_fly_zone', label:'No-fly zone', mapTitle:'Coverage sweep &mdash; zone appears mid-flight',
    brief:'A restricted zone is announced partway through a coverage sweep, straddling one row of the pattern. '
        + '<strong>GroundLink detects that the zone blocks the remaining route, plans a detour around it, and finishes the sweep.</strong> '
        + 'The baseline system has one response to any failure &mdash; return to launch &mdash; so it abandons the rest of the survey.',
    headline:{
      eyebrow:'Measured outcome — no-fly zone',
      metric:'Share of the planned survey actually completed',
      adaptive:'83.3%', baseline:'50.0%',
      delta:'+33.3 points covered',
      foot:'Five trials per condition. The restricted zone was never entered in any of the ten flights — verified geometrically against every recorded position, not inferred from the outcome.'
    }
  },
  {
    key:'battery_critical', label:'Battery critical', mapTitle:'Outbound leg &mdash; battery crosses critical',
    brief:'Battery falls to a critical level mid-mission. <strong>GroundLink detects the crossing from live telemetry and commands a return to launch</strong>, '
        + 'then tracks it through to a confirmed touchdown and disarm rather than trusting the mode switch alone. '
        + 'Under a steeper drain it lands on the spot instead, rather than gambling on a return it may not have the charge to finish.',
    headline:{
      eyebrow:'Measured outcome — severe battery drain',
      metric:'Time from detection to a confirmed safe state',
      adaptive:'19.8s', baseline:'51.3s',
      delta:'2.6× faster to safe',
      foot:'Five trials per condition. GroundLink lands immediately at this severity; the baseline attempts a full return-to-launch regardless of how little charge is left.'
    }
  },
  {
    key:'gps_degraded', label:'GPS degraded', mapTitle:'Cruise &mdash; GPS fix lost mid-leg',
    brief:'The GPS fix drops out mid-cruise. <strong>GroundLink holds position immediately</strong> rather than navigating on a position estimate it can no longer trust. '
        + 'The baseline reaches for return-to-launch, which is the one response that cannot work here &mdash; returning home depends on the fix that just failed.',
    headline:{
      eyebrow:'Measured outcome — GPS dropout',
      metric:'Flights that reached a confirmed safe state',
      adaptive:'5/5', baseline:'0/5',
      delta:'Baseline never recovered',
      foot:'Five trials per condition. In every baseline flight PX4 accepted the return-to-launch command, then overrode it to LAND within about five seconds, and distance to home did not close.'
    }
  }
];

const SPEEDS = [1,2,4,8];

/* ---- state ------------------------------------------------------------- */
const S = {
  key:null, sc:null, meta:null, proj:null,
  t:0, maxT:1, playing:false, speed:4, raf:null, last:null,
  layers:{ planned:true, flown:true, zone:true, rings:true },
  nodes:{}
};

/* ---- svg helpers -------------------------------------------------------- */
const SVGNS = 'http://www.w3.org/2000/svg';
function mk(tag, attrs){
  const n = document.createElementNS(SVGNS, tag);
  if (attrs) for (const k in attrs) n.setAttribute(k, attrs[k]);
  return n;
}

const VW = 1000, VH = 600, INSET = 62;

function buildProjection(sc){
  const [oLat, oLon] = sc.home;
  const pts = [];
  sc.mission.forEach(w => pts.push(localXY(w.lat, w.lon, oLat, oLon)));
  sc.series.forEach(p => pts.push(localXY(p.lat, p.lon, oLat, oLon)));
  (sc.zone_boundary||[]).forEach(([a,b]) => pts.push(localXY(a, b, oLat, oLon)));
  (sc.replanned_waypoints||[]).forEach(w => pts.push(localXY(w.lat, w.lon, oLat, oLon)));

  let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
  pts.forEach(([x,y]) => { if(x<minX)minX=x; if(x>maxX)maxX=x; if(y<minY)minY=y; if(y>maxY)maxY=y; });
  const spanX = Math.max(maxX-minX, 20), spanY = Math.max(maxY-minY, 20);
  const scale = Math.min((VW-INSET*2)/spanX, (VH-INSET*2)/spanY);
  const cx = (minX+maxX)/2, cy = (minY+maxY)/2;
  return {
    oLat, oLon, scale,
    to(lat, lon){
      const [x,y] = localXY(lat, lon, oLat, oLon);
      return [ VW/2 + (x-cx)*scale, VH/2 - (y-cy)*scale ];   /* north is up */
    }
  };
}

function sampleAt(series, t){
  if (t <= series[0].t) return series[0];
  const last = series[series.length-1];
  if (t >= last.t) return last;
  let lo = 0, hi = series.length-1;
  while (hi - lo > 1){
    const mid = (lo+hi) >> 1;
    if (series[mid].t <= t) lo = mid; else hi = mid;
  }
  const a = series[lo], b = series[hi];
  const span = b.t - a.t;
  const f = span < 1e-6 ? 0 : (t - a.t)/span;
  return {
    t, lat:a.lat+(b.lat-a.lat)*f, lon:a.lon+(b.lon-a.lon)*f,
    alt:a.alt+(b.alt-a.alt)*f, mode:(f < .5 ? a.mode : b.mode), idx:lo
  };
}

/* ---- chart -------------------------------------------------------------- */
function drawChart(){
  const sc = S.sc, P = S.proj, svg = S.nodes.chart;
  svg.textContent = '';

  const defs = mk('defs');
  const hatch = mk('pattern', {id:'zoneHatch', width:7, height:7, patternUnits:'userSpaceOnUse', patternTransform:'rotate(45)'});
  hatch.appendChild(mk('line', {x1:0, y1:0, x2:0, y2:7, stroke:'var(--alert)', 'stroke-width':1, opacity:.34}));
  defs.appendChild(hatch);
  svg.appendChild(defs);

  /* graticule */
  const grid = mk('g', {'shape-rendering':'crispEdges'});
  for (let x=0; x<=VW; x+=50) grid.appendChild(mk('line',{x1:x,y1:0,x2:x,y2:VH,stroke:'var(--map-grid)','stroke-width':1}));
  for (let y=0; y<=VH; y+=50) grid.appendChild(mk('line',{x1:0,y1:y,x2:VW,y2:y,stroke:'var(--map-grid)','stroke-width':1}));
  svg.appendChild(grid);

  const [hx, hy] = P.to(sc.home[0], sc.home[1]);

  /* range rings from launch point */
  const rings = mk('g'); S.nodes.rings = rings;
  [100, 200, 300].forEach(m => {
    const r = m * P.scale;
    if (r < 26 || r > 900) return;
    rings.appendChild(mk('circle',{cx:hx, cy:hy, r, fill:'none', stroke:'var(--map-ring)', 'stroke-width':1, 'stroke-dasharray':'2 6'}));
    const lb = mk('text',{x:hx+5, y:hy-r+11, fill:'var(--map-ring-ink)', 'font-size':9.5, 'font-family':'var(--mono)', 'letter-spacing':'.06em'});
    lb.textContent = m + ' m';
    rings.appendChild(lb);
  });
  svg.appendChild(rings);

  /* north arrow */
  const rose = mk('g', {transform:`translate(${VW-40},40)`});
  rose.appendChild(mk('line',{x1:0,y1:9,x2:0,y2:-11,stroke:'var(--map-ring-ink)','stroke-width':1.2}));
  rose.appendChild(mk('path',{d:'M0 -14 L-3.4 -6.5 L3.4 -6.5 Z', fill:'var(--map-ring-ink)'}));
  const nt = mk('text',{x:0,y:-19,fill:'var(--map-ring-ink)','font-size':9.5,'text-anchor':'middle','font-family':'var(--mono)','letter-spacing':'.1em'});
  nt.textContent='N'; rose.appendChild(nt);
  svg.appendChild(rose);

  /* restricted zone */
  const zoneG = mk('g'); S.nodes.zone = zoneG;
  if (sc.zone_boundary && sc.zone_boundary.length){
    const zp = sc.zone_boundary.map(([a,b]) => P.to(a,b));
    const pstr = zp.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
    zoneG.appendChild(mk('polygon',{points:pstr, fill:'url(#zoneHatch)', stroke:'var(--alert)', 'stroke-width':1.4}));
    const cxz = zp.reduce((s,p)=>s+p[0],0)/zp.length, cyz = zp.reduce((s,p)=>s+p[1],0)/zp.length;
    const zt = mk('text',{x:cxz, y:cyz, fill:'var(--alert)','font-size':10,'text-anchor':'middle','font-family':'var(--mono)','letter-spacing':'.16em'});
    zt.textContent='RESTRICTED'; zoneG.appendChild(zt);
  }
  svg.appendChild(zoneG);

  /* planned route — dashed amber (a plan, not a track) */
  const plannedG = mk('g'); S.nodes.planned = plannedG;
  const mp = sc.mission.map(w => P.to(w.lat, w.lon));
  plannedG.appendChild(mk('polyline',{
    points: mp.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' '),
    fill:'none', stroke:'var(--planned)', 'stroke-width':1.6, 'stroke-dasharray':'7 5', 'stroke-linejoin':'round'
  }));
  mp.forEach(([x,y]) => {
    plannedG.appendChild(mk('circle',{cx:x, cy:y, r:3.2, fill:'var(--map-bg)', stroke:'var(--planned)', 'stroke-width':1.4}));
  });
  /* replanned leg — dashed magenta: still a plan, but now the active one */
  if (sc.replanned_waypoints && sc.replanned_waypoints.length){
    const rp = sc.replanned_waypoints.map(w => P.to(w.lat, w.lon));
    plannedG.appendChild(mk('polyline',{
      points: rp.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' '),
      fill:'none', stroke:'var(--active)', 'stroke-width':1.6, 'stroke-dasharray':'7 5',
      'stroke-linejoin':'round', opacity:.75
    }));
  }
  svg.appendChild(plannedG);

  /* launch point */
  const homeG = mk('g',{transform:`translate(${hx},${hy})`});
  homeG.appendChild(mk('circle',{r:5.5, fill:'none', stroke:'var(--ink-2)', 'stroke-width':1.4}));
  homeG.appendChild(mk('circle',{r:1.7, fill:'var(--ink-2)'}));
  svg.appendChild(homeG);

  /* flown track — solid magenta, drawn progressively */
  const flownG = mk('g'); S.nodes.flown = flownG;
  S.nodes.trackGlow = mk('polyline',{points:'', fill:'none', stroke:'var(--active)', 'stroke-width':6,
    'stroke-linecap':'round','stroke-linejoin':'round', opacity:.16});
  S.nodes.track = mk('polyline',{points:'', fill:'none', stroke:'var(--active)', 'stroke-width':2.1,
    'stroke-linecap':'round','stroke-linejoin':'round'});
  flownG.appendChild(S.nodes.trackGlow);
  flownG.appendChild(S.nodes.track);
  svg.appendChild(flownG);

  /* replan trigger marker */
  const trig = mk('g',{opacity:0}); S.nodes.trigger = trig;
  const ring = mk('circle',{r:6, fill:'none', stroke:'var(--planned)', 'stroke-width':1.5});
  ring.appendChild(mk('animate',{attributeName:'r', values:'6;19', dur:'1.9s', repeatCount:'indefinite'}));
  ring.appendChild(mk('animate',{attributeName:'opacity', values:'.85;0', dur:'1.9s', repeatCount:'indefinite'}));
  trig.appendChild(ring);
  trig.appendChild(mk('circle',{r:4, fill:'var(--planned)'}));
  const tl = mk('text',{y:-13, fill:'var(--planned)', 'font-size':9.5, 'text-anchor':'middle',
    'font-family':'var(--mono)', 'letter-spacing':'.14em'});
  tl.textContent='REPLAN'; trig.appendChild(tl);
  svg.appendChild(trig);

  /* own-ship */
  const ship = mk('g'); S.nodes.ship = ship;
  ship.appendChild(mk('circle',{r:10, fill:'var(--active)', opacity:.14}));
  ship.appendChild(mk('path',{d:'M0 -7.5 L5 5.5 L0 3 L-5 5.5 Z', fill:'var(--ink)', stroke:'var(--map-bg)', 'stroke-width':.8}));
  svg.appendChild(ship);

  applyLayers();
}

function applyLayers(){
  const n = S.nodes;
  if (n.planned) n.planned.style.display = S.layers.planned ? '' : 'none';
  if (n.flown)   n.flown.style.display   = S.layers.flown   ? '' : 'none';
  if (n.zone)    n.zone.style.display    = S.layers.zone    ? '' : 'none';
  if (n.rings)   n.rings.style.display   = S.layers.rings   ? '' : 'none';
}

/* ---- per-frame render --------------------------------------------------- */
function render(){
  const sc = S.sc, P = S.proj;
  const cur = sampleAt(sc.series, S.t);
  const [x,y] = P.to(cur.lat, cur.lon);

  /* progressive track */
  let d = '';
  for (let i=0; i<=cur.idx; i++){
    const p = sc.series[i];
    const [px,py] = P.to(p.lat, p.lon);
    d += px.toFixed(1)+','+py.toFixed(1)+' ';
  }
  d += x.toFixed(1)+','+y.toFixed(1);
  S.nodes.track.setAttribute('points', d);
  S.nodes.trackGlow.setAttribute('points', d);

  /* heading from recent travel */
  let hdg = 0;
  const back = sc.series[Math.max(0, cur.idx-2)];
  if (back){
    const [bx,by] = P.to(back.lat, back.lon);
    const dx = x-bx, dy = y-by;
    if (Math.hypot(dx,dy) > .6) hdg = Math.atan2(dx, -dy) * 180/Math.PI;
  }
  S.nodes.ship.setAttribute('transform', `translate(${x.toFixed(1)},${y.toFixed(1)}) rotate(${hdg.toFixed(1)})`);

  /* trigger */
  const tt = sc.t_replan_trigger;
  if (tt != null){
    const tp = sampleAt(sc.series, tt);
    const [tx,ty] = P.to(tp.lat, tp.lon);
    S.nodes.trigger.setAttribute('transform', `translate(${tx.toFixed(1)},${ty.toFixed(1)})`);
    S.nodes.trigger.setAttribute('opacity', S.t >= tt ? 1 : 0);
  }

  /* readouts */
  S.nodes.roAlt.textContent = cur.alt.toFixed(1) + ' m';
  S.nodes.roMode.textContent = cur.mode || '—';
  S.nodes.roMode.setAttribute('data-mode', cur.mode || '');
  S.nodes.roTime.textContent = S.t.toFixed(1) + ' s';
  const replanning = tt != null && S.t >= tt;
  S.nodes.roState.textContent = replanning ? 'Replanned' : 'Nominal';
  S.nodes.roState.setAttribute('data-state', replanning ? 'replanning' : 'nominal');

  /* transport */
  const pct = S.maxT ? (S.t/S.maxT)*100 : 0;
  S.nodes.scrubFill.style.width = pct + '%';
  S.nodes.scrubThumb.style.left = pct + '%';
  S.nodes.tpTime.textContent = S.t.toFixed(1) + ' / ' + S.maxT.toFixed(1) + ' s';
  S.nodes.scrub.setAttribute('aria-valuenow', S.t.toFixed(1));

  paintTimeline();
}

/* ---- timeline ----------------------------------------------------------- */
function buildEvents(sc){
  const ev = [{t:0, kind:'start', text:'Mission uploaded, climbing to cruise altitude'}];
  const tt = sc.t_replan_trigger;
  if (sc.scenario === 'no_fly_zone'){
    ev.push({t:tt, kind:'trigger', text:'Restricted zone announced &mdash; route replanned around it'});
    ev.push({t:sc.series[sc.series.length-1].t, kind:'end', text:'Survey completed by way of the detour'});
  } else if (sc.scenario === 'battery_critical'){
    ev.push({t:tt, kind:'trigger', text:`Battery critical at <strong>${sc.detected_percent}%</strong> &mdash; return to launch commanded`});
    if (sc.t_to_safe_recovery_s != null) ev.push({t:tt + sc.t_to_safe_recovery_s, kind:'end', text:'Touched down and disarmed &mdash; safe state confirmed'});
  } else {
    ev.push({t:tt, kind:'trigger', text:`GPS fix lost (<strong>${sc.detected_fix_type}</strong>) &mdash; holding position`});
    if (sc.t_to_safe_recovery_s != null) ev.push({t:tt + sc.t_to_safe_recovery_s, kind:'end', text:'Stopped and holding &mdash; safe state confirmed'});
  }
  return ev.filter(e => e.t != null);
}

function renderTimeline(){
  const host = S.nodes.timeline;
  host.textContent = '';
  S.sc.__events.forEach((e, i, arr) => {
    const item = document.createElement('div');
    item.className = 'tl-item';
    item.setAttribute('data-kind', e.kind);
    item.innerHTML =
      `<div class="tl-time">${e.t.toFixed(1)}s</div>` +
      `<div class="tl-rail"><span class="tl-node"></span>${i < arr.length-1 ? '<span class="tl-line"></span>' : ''}</div>` +
      `<div class="tl-text">${e.text}</div>`;
    host.appendChild(item);
  });
  paintTimeline();
}

function paintTimeline(){
  const ev = S.sc.__events, host = S.nodes.timeline;
  let cur = -1;
  ev.forEach((e,i) => { if (S.t >= e.t) cur = i; });
  Array.prototype.forEach.call(host.children, (el, i) => {
    el.setAttribute('data-state', i === cur ? 'current' : (i < cur ? 'reached' : 'pending'));
  });
}

/* ---- transport ---------------------------------------------------------- */
function setPlaying(on){
  S.playing = on;
  S.nodes.playIcon.innerHTML = on
    ? '<path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/>'
    : '<path d="M8 5v14l11-7z"/>';
  S.nodes.playBtn.setAttribute('aria-label', on ? 'Pause' : 'Play');
  if (on){
    if (S.t >= S.maxT) S.t = 0;
    S.last = null;
    S.raf = requestAnimationFrame(step);
  } else if (S.raf){
    cancelAnimationFrame(S.raf); S.raf = null;
  }
}
function step(ts){
  if (!S.playing) return;
  if (S.last == null) S.last = ts;
  S.t = Math.min(S.maxT, S.t + ((ts - S.last)/1000) * S.speed);
  S.last = ts;
  render();
  if (S.t >= S.maxT){ setPlaying(false); return; }
  S.raf = requestAnimationFrame(step);
}
function seekFromPointer(clientX){
  const r = S.nodes.scrub.getBoundingClientRect();
  const f = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
  S.t = f * S.maxT;
  render();
}

/* ---- comparison matrix -------------------------------------------------- */
const CMP_ROWS = [
  ['No-fly zone (coverage sweep)', 'no-fly-zone (coverage mission)'],
  ['Battery critical (moderate)',  'battery-critical (moderate, 12%)'],
  ['Battery critical (severe)',    'battery-critical (severe, ~5%)'],
  ['GPS degraded',                 'gps-degradation'],
];
function firstNum(s){ const m = /(-?\d+(?:\.\d+)?)/.exec(s||''); return m ? parseFloat(m[1]) : null; }
function clean(s){ return (s||'').split(' (')[0].trim(); }

function renderMatrix(){
  const body = document.getElementById('cmpBody');
  body.textContent = '';
  CMP_ROWS.forEach(([label, key]) => {
    const g = DATA.comparison[key];
    if (!g) return;
    ['adaptive','baseline'].forEach((cond, ci) => {
      const d = g[cond];
      const tr = document.createElement('tr');
      const comp = clean(d.completion), rec = clean(d.recovery_time);
      const compN = firstNum(comp), recN = firstNum(rec);
      const safeM = /(\d+)\s*\/\s*(\d+)/.exec(d.safe_rate);
      const safeN = safeM ? parseInt(safeM[1],10) : null;
      const safeD = safeM ? parseInt(safeM[2],10) : 5;

      tr.innerHTML =
        `<td class="cmp-scenario">${ci === 0 ? label : ''}</td>` +
        `<td><span class="cmp-cond" data-c="${cond}">${cond}</span></td>` +
        `<td><div class="cmp-bar"><span class="cmp-num">${compN==null?'—':comp+'%'}</span>` +
          `<span class="cmp-bar-track"><span class="cmp-bar-fill" data-c="${cond}" data-w="${compN==null?0:compN}"></span></span></div></td>` +
        `<td><span class="cmp-num">${recN==null?'—':rec+'s'}</span></td>` +
        `<td><div class="cmp-bar"><span class="cmp-num">${d.safe_rate}</span>` +
          `<span class="cmp-bar-track"><span class="cmp-bar-fill" data-c="${cond}" data-w="${safeN==null?0:(safeN/safeD)*100}"></span></span></div></td>`;
      body.appendChild(tr);
    });
  });
  requestAnimationFrame(() => {
    setTimeout(() => {
      body.querySelectorAll('.cmp-bar-fill').forEach(f => { f.style.width = Math.min(100, parseFloat(f.dataset.w)) + '%'; });
    }, 40);
  });
}

/* ---- scenario switching -------------------------------------------------- */
function select(key){
  const meta = SCENARIOS.find(s => s.key === key);
  S.key = key; S.meta = meta;
  S.sc = DATA.scenarios[key];
  S.sc.__events = buildEvents(S.sc);
  S.proj = buildProjection(S.sc);
  S.maxT = S.sc.series[S.sc.series.length-1].t;
  S.t = 0;
  setPlaying(false);

  document.getElementById('mapTitle').innerHTML = meta.mapTitle;
  document.getElementById('mapNote').textContent =
    `${S.sc.series.length} samples · ${S.maxT.toFixed(0)}s`;
  document.getElementById('brief').innerHTML = meta.brief;

  const h = meta.headline;
  document.getElementById('verdictEyebrow').textContent = h.eyebrow;
  document.getElementById('verdictMetric').textContent = h.metric;
  document.getElementById('verdictFoot').textContent = h.foot;
  document.getElementById('figAdaptive').textContent = h.adaptive;
  document.getElementById('figBaseline').textContent = h.baseline;
  document.getElementById('verdictDelta').textContent = h.delta;

  S.nodes.scrub.setAttribute('aria-valuemax', S.maxT.toFixed(1));
  const tt = S.sc.t_replan_trigger;
  S.nodes.scrubTick.style.display = tt == null ? 'none' : '';
  if (tt != null) S.nodes.scrubTick.style.left = ((tt/S.maxT)*100) + '%';

  Array.prototype.forEach.call(document.querySelectorAll('.sel-btn'), b => {
    const on = b.dataset.key === key;
    b.setAttribute('aria-selected', on ? 'true' : 'false');
    if (on) placeIndicator(b);
  });

  drawChart();
  renderTimeline();
  render();
}
function placeIndicator(btn){
  const host = document.getElementById('selector');
  const ind = document.getElementById('selIndicator');
  ind.style.left = (btn.offsetLeft) + 'px';
  ind.style.width = (btn.offsetWidth) + 'px';
}

/* ---- boot ---------------------------------------------------------------- */
(function init(){
  S.nodes = {
    chart: document.getElementById('chart'),
    timeline: document.getElementById('timeline'),
    playBtn: document.getElementById('playBtn'),
    playIcon: document.getElementById('playIcon'),
    scrub: document.getElementById('scrub'),
    scrubFill: document.getElementById('scrubFill'),
    scrubThumb: document.getElementById('scrubThumb'),
    scrubTick: document.getElementById('scrubTick'),
    tpTime: document.getElementById('tpTime'),
    roAlt: document.getElementById('roAlt'),
    roMode: document.getElementById('roMode'),
    roTime: document.getElementById('roTime'),
    roState: document.getElementById('roState'),
  };

  /* scenario tabs */
  const sel = document.getElementById('selector');
  SCENARIOS.forEach(s => {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'sel-btn'; b.dataset.key = s.key;
    b.setAttribute('role','tab'); b.setAttribute('aria-selected','false');
    b.textContent = s.label;
    b.addEventListener('click', () => select(s.key));
    sel.appendChild(b);
  });

  /* speeds */
  const speeds = document.getElementById('tpSpeeds');
  SPEEDS.forEach(m => {
    const b = document.createElement('button');
    b.type='button'; b.className='tp-speed'; b.textContent = m + '×';
    b.setAttribute('aria-pressed', m === S.speed ? 'true' : 'false');
    b.addEventListener('click', () => {
      S.speed = m;
      speeds.querySelectorAll('.tp-speed').forEach(o => o.setAttribute('aria-pressed', o === b ? 'true' : 'false'));
    });
    speeds.appendChild(b);
  });

  S.nodes.playBtn.addEventListener('click', () => setPlaying(!S.playing));

  /* scrubbing */
  let dragging = false;
  const scrub = S.nodes.scrub;
  scrub.addEventListener('pointerdown', e => {
    dragging = true; scrub.setPointerCapture(e.pointerId);
    setPlaying(false); seekFromPointer(e.clientX);
  });
  scrub.addEventListener('pointermove', e => { if (dragging) seekFromPointer(e.clientX); });
  scrub.addEventListener('pointerup', e => { dragging = false; scrub.releasePointerCapture(e.pointerId); });
  scrub.addEventListener('pointercancel', () => { dragging = false; });
  scrub.addEventListener('keydown', e => {
    const stepS = e.shiftKey ? 10 : 1;
    if (e.key === 'ArrowRight'){ setPlaying(false); S.t = Math.min(S.maxT, S.t + stepS); render(); e.preventDefault(); }
    if (e.key === 'ArrowLeft'){ setPlaying(false); S.t = Math.max(0, S.t - stepS); render(); e.preventDefault(); }
    if (e.key === 'Home'){ setPlaying(false); S.t = 0; render(); e.preventDefault(); }
    if (e.key === 'End'){ setPlaying(false); S.t = S.maxT; render(); e.preventDefault(); }
    if (e.key === ' '){ setPlaying(!S.playing); e.preventDefault(); }
  });

  /* layer toggles */
  document.querySelectorAll('.layer').forEach(btn => {
    btn.addEventListener('click', () => {
      const k = btn.dataset.layer;
      S.layers[k] = !S.layers[k];
      btn.setAttribute('aria-pressed', S.layers[k] ? 'true' : 'false');
      applyLayers();
    });
  });

  /* day / night */
  const night = document.getElementById('modeNight'), day = document.getElementById('modeDay');
  function setMode(m){
    document.documentElement.setAttribute('data-theme', m);
    night.setAttribute('aria-pressed', m === 'dark' ? 'true' : 'false');
    day.setAttribute('aria-pressed', m === 'light' ? 'true' : 'false');
  }
  night.addEventListener('click', () => setMode('dark'));
  day.addEventListener('click', () => setMode('light'));
  setMode(window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

  window.addEventListener('resize', () => {
    const on = document.querySelector('.sel-btn[aria-selected="true"]');
    if (on) placeIndicator(on);
  });

  renderMatrix();
  select('no_fly_zone');
})();
</script>
</body>
</html>
