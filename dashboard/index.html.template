<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GroundLink — Flight Replay</title>
<style>
  :root{
    --bg:#080b11;
    --bg-1:#0d1119;
    --panel:#10141d;
    --panel-2:#141a25;
    --border:#212838;
    --border-soft:#1a2030;
    --text-0:#f3f6fa;
    --text-1:#aab3c5;
    --text-2:#6c7690;
    --cyan:#3ee6c8;
    --cyan-dim:#1f7c6d;
    --amber:#f0a840;
    --amber-dim:#8a6428;
    --violet:#9b8cfb;
    --red:#ff6161;
    --green:#4fd68a;
    --mono: "SF Mono", "Cascadia Code", "Consolas", ui-monospace, monospace;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
    --radius: 14px;
    --radius-sm: 9px;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    background:
      radial-gradient(1200px 700px at 12% -10%, #101c26 0%, transparent 60%),
      radial-gradient(1000px 600px at 100% 0%, #1a1430 0%, transparent 55%),
      var(--bg);
    color:var(--text-0);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  ::selection{ background:var(--cyan-dim); color:#fff; }
  ::-webkit-scrollbar{ width:9px; height:9px; }
  ::-webkit-scrollbar-track{ background:transparent; }
  ::-webkit-scrollbar-thumb{ background:var(--border); border-radius:6px; }

  .shell{ max-width:1500px; margin:0 auto; padding:28px 32px 60px; }

  /* ---------- header ---------- */
  header.top{
    display:flex; align-items:flex-end; justify-content:space-between;
    margin-bottom:22px; gap:24px; flex-wrap:wrap;
  }
  .brand{ display:flex; align-items:center; gap:14px; }
  .brand-mark{
    width:40px; height:40px; border-radius:11px;
    background:linear-gradient(145deg, var(--cyan) 0%, #1c8f92 100%);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 0 0 1px rgba(62,230,200,.25), 0 8px 24px -8px rgba(62,230,200,.45);
    flex-shrink:0;
  }
  .brand-mark svg{ width:22px; height:22px; }
  .brand h1{
    font-size:19px; font-weight:650; letter-spacing:-.01em; margin:0; line-height:1.15;
  }
  .brand p{ margin:2px 0 0; font-size:12.5px; color:var(--text-2); letter-spacing:.01em; }
  .top-right{ display:flex; align-items:center; gap:10px; }
  .badge{
    font-family:var(--mono); font-size:11px; letter-spacing:.03em;
    color:var(--text-1); background:var(--panel); border:1px solid var(--border);
    padding:6px 11px; border-radius:100px; display:flex; align-items:center; gap:7px;
  }
  .badge .dot{ width:6px; height:6px; border-radius:50%; background:var(--green); box-shadow:0 0 8px var(--green); }

  /* ---------- scenario tabs ---------- */
  .tabs{
    display:flex; gap:6px; background:var(--panel); border:1px solid var(--border);
    padding:5px; border-radius:12px; margin-bottom:20px; width:fit-content;
  }
  .tab{
    appearance:none; border:none; background:transparent; color:var(--text-1);
    font-family:var(--sans); font-size:13px; font-weight:560; letter-spacing:.005em;
    padding:9px 18px; border-radius:9px; cursor:pointer; transition:color .2s ease;
    position:relative; white-space:nowrap;
  }
  .tab.active{ color:#04120f; }
  .tab-indicator{
    position:absolute; top:5px; bottom:5px; border-radius:9px;
    background:linear-gradient(135deg, var(--cyan), #29b39d);
    box-shadow:0 4px 16px -4px rgba(62,230,200,.55);
    transition:left .32s cubic-bezier(.65,0,.35,1), width .32s cubic-bezier(.65,0,.35,1);
    z-index:0;
  }
  .tab span{ position:relative; z-index:1; }

  /* ---------- layout grid ---------- */
  .grid{ display:grid; grid-template-columns:1fr 360px; gap:20px; align-items:start; }
  @media (max-width:980px){ .grid{ grid-template-columns:1fr; } }

  .card{
    background:linear-gradient(180deg, var(--panel-2) 0%, var(--panel) 100%);
    border:1px solid var(--border); border-radius:var(--radius);
    box-shadow:0 1px 0 rgba(255,255,255,.02) inset, 0 20px 40px -24px rgba(0,0,0,.6);
  }
  .card-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 18px 12px; border-bottom:1px solid var(--border-soft);
  }
  .card-head h2{ font-size:13px; font-weight:620; margin:0; color:var(--text-0); letter-spacing:.01em; }
  .card-head .sub{ font-size:11.5px; color:var(--text-2); font-family:var(--mono); }

  /* ---------- map card ---------- */
  .map-wrap{ position:relative; }
  .map-svg-holder{ padding:14px; }
  svg.map{ width:100%; height:auto; display:block; border-radius:10px; background:#0a0f16; }

  .legend{
    display:flex; gap:16px; flex-wrap:wrap; padding:0 18px 16px; font-size:11.5px; color:var(--text-1);
  }
  .legend-item{ display:flex; align-items:center; gap:7px; }
  .legend-swatch{ width:16px; height:3px; border-radius:2px; flex-shrink:0; }
  .legend-swatch.dashed{ background:repeating-linear-gradient(90deg, currentColor 0 6px, transparent 6px 10px); height:2px; }
  .legend-dot{ width:9px; height:9px; border-radius:50%; flex-shrink:0; }

  /* ---------- playback ---------- */
  .playback{ padding:14px 18px 18px; border-top:1px solid var(--border-soft); }
  .playback-row{ display:flex; align-items:center; gap:12px; }
  .play-btn{
    width:38px; height:38px; border-radius:50%; border:1px solid var(--border);
    background:var(--panel); color:var(--text-0); display:flex; align-items:center; justify-content:center;
    cursor:pointer; flex-shrink:0; transition:background .15s ease, transform .1s ease, border-color .15s ease;
  }
  .play-btn:hover{ background:#1a2130; border-color:#2c3547; }
  .play-btn:active{ transform:scale(.93); }
  .play-btn svg{ width:15px; height:15px; }
  input[type=range]{
    -webkit-appearance:none; appearance:none; flex:1; height:4px; border-radius:3px;
    background:var(--border); outline:none; cursor:pointer;
  }
  input[type=range]::-webkit-slider-thumb{
    -webkit-appearance:none; width:14px; height:14px; border-radius:50%;
    background:var(--cyan); box-shadow:0 0 0 4px rgba(62,230,200,.18), 0 2px 6px rgba(0,0,0,.5);
    cursor:pointer; margin-top:-5px;
  }
  input[type=range]::-webkit-slider-runnable-track{ height:4px; border-radius:3px; }
  .time-read{ font-family:var(--mono); font-size:11.5px; color:var(--text-1); white-space:nowrap; min-width:86px; text-align:right; }
  .speed-row{ display:flex; gap:6px; margin-top:11px; }
  .speed-btn{
    font-family:var(--mono); font-size:11px; color:var(--text-2); background:transparent;
    border:1px solid var(--border); padding:4px 9px; border-radius:6px; cursor:pointer; transition:all .15s ease;
  }
  .speed-btn.active{ color:#04120f; background:var(--cyan); border-color:var(--cyan); font-weight:600; }

  /* ---------- telemetry strip ---------- */
  .telemetry{
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    background:var(--border-soft); border-top:1px solid var(--border-soft);
  }
  .telemetry .cell{ background:var(--panel); padding:12px 16px; }
  .telemetry .label{ font-size:10px; color:var(--text-2); text-transform:uppercase; letter-spacing:.08em; margin-bottom:5px; }
  .telemetry .value{ font-family:var(--mono); font-size:16px; font-weight:600; color:var(--text-0); }
  .telemetry .value.mode-MISSION{ color:var(--text-0); }
  .telemetry .value.mode-HOLD{ color:var(--amber); }
  .telemetry .value.mode-RETURN_TO_LAUNCH{ color:var(--violet); }
  .telemetry .value.mode-LAND{ color:var(--red); }

  /* ---------- sidebar ---------- */
  .side{ display:flex; flex-direction:column; gap:16px; }
  .scenario-blurb{ padding:16px 18px; font-size:12.5px; line-height:1.55; color:var(--text-1); }
  .scenario-blurb b{ color:var(--text-0); font-weight:600; }

  .event-log{ padding:6px 8px 12px; max-height:230px; overflow-y:auto; }
  .event{
    display:flex; gap:11px; padding:10px 10px; border-radius:9px; opacity:.42;
    transition:opacity .3s ease, background .3s ease;
  }
  .event.active{ opacity:1; background:rgba(62,230,200,.07); }
  .event.past{ opacity:.75; }
  .event-time{
    font-family:var(--mono); font-size:10.5px; color:var(--text-2); width:44px; flex-shrink:0; padding-top:2px;
  }
  .event.active .event-time{ color:var(--cyan); }
  .event-dot-col{ display:flex; flex-direction:column; align-items:center; padding-top:3px; }
  .event-dot{ width:7px; height:7px; border-radius:50%; background:var(--border); flex-shrink:0; }
  .event.active .event-dot{ background:var(--cyan); box-shadow:0 0 8px var(--cyan); }
  .event.trigger .event-dot{ background:var(--amber); }
  .event.trigger.active .event-dot{ background:var(--amber); box-shadow:0 0 8px var(--amber); }
  .event-line{ width:1px; flex:1; background:var(--border-soft); margin-top:3px; }
  .event-text{ font-size:12px; color:var(--text-1); line-height:1.4; padding-bottom:2px; }
  .event.active .event-text{ color:var(--text-0); }
  .event-text b{ color:var(--text-0); font-weight:600; }

  /* ---------- stat cards ---------- */
  .stat-group{ padding:16px 18px 18px; display:flex; flex-direction:column; gap:12px; }
  .stat-group-title{ font-size:10.5px; text-transform:uppercase; letter-spacing:.09em; color:var(--text-2); margin-bottom:2px; }
  .compare-row{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .compare-card{
    border:1px solid var(--border-soft); border-radius:10px; padding:12px 13px;
    background:var(--panel); position:relative; overflow:hidden;
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .compare-card:hover{ transform:translateY(-2px); box-shadow:0 14px 26px -14px rgba(0,0,0,.55); border-color:#2a3348; }
  .compare-card.adaptive{ border-top:2px solid var(--cyan); }
  .compare-card.baseline{ border-top:2px solid var(--amber); }
  .compare-card .tag{
    font-size:9.5px; text-transform:uppercase; letter-spacing:.08em; font-weight:700; margin-bottom:8px;
  }
  .compare-card.adaptive .tag{ color:var(--cyan); }
  .compare-card.baseline .tag{ color:var(--amber); }
  .compare-metric{ margin-bottom:7px; }
  .compare-metric:last-child{ margin-bottom:0; }
  .compare-metric .k{ font-size:9.5px; color:var(--text-2); letter-spacing:.02em; }
  .compare-metric .v{ font-family:var(--mono); font-size:14.5px; font-weight:650; color:var(--text-0); }

  .headline-pill{
    display:flex; align-items:center; gap:9px; padding:10px 13px; border-radius:10px;
    background:linear-gradient(135deg, rgba(62,230,200,.13), rgba(62,230,200,.04));
    border:1px solid rgba(62,230,200,.28); font-size:12px; color:var(--text-0);
  }
  .headline-pill svg{ width:15px; height:15px; color:var(--cyan); flex-shrink:0; }
  .headline-pill b{ color:var(--cyan); font-weight:700; }

  /* ---------- overview bars (bottom) ---------- */
  .overview{ margin-top:20px; }
  .overview .card-head p.desc{ margin:2px 0 0; font-size:11.5px; color:var(--text-2); }
  .bars{ padding:18px; display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  @media (max-width:820px){ .bars{ grid-template-columns:1fr; } }
  .bar-block .bar-title{ font-size:12px; font-weight:600; color:var(--text-0); margin-bottom:2px; }
  .bar-block .bar-sub{ font-size:11px; color:var(--text-2); margin-bottom:12px; font-family:var(--mono); }
  .bar-line{ display:flex; align-items:center; gap:10px; margin-bottom:9px; }
  .bar-line .bl-label{ width:64px; flex-shrink:0; font-size:11px; color:var(--text-1); text-align:right; }
  .bar-line .bl-track{ flex:1; height:20px; background:var(--border-soft); border-radius:6px; overflow:hidden; position:relative; }
  .bar-line .bl-fill{ height:100%; border-radius:6px; width:0%; transition:width 1s cubic-bezier(.2,.8,.2,1); position:relative; }
  .bar-line .bl-fill.adaptive{ background:linear-gradient(90deg, var(--cyan-dim), var(--cyan)); }
  .bar-line .bl-fill.baseline{ background:linear-gradient(90deg, var(--amber-dim), var(--amber)); }
  .bar-line .bl-val{ font-family:var(--mono); font-size:10.5px; color:var(--text-0); width:64px; flex-shrink:0; }

  footer.foot{
    margin-top:30px; padding-top:16px; border-top:1px solid var(--border-soft);
    font-size:11px; color:var(--text-2); display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;
  }
  footer.foot a{ color:var(--text-1); }

  @keyframes pulse-ring{
    0%{ transform:scale(.4); opacity:.9; }
    70%{ transform:scale(2.6); opacity:0; }
    100%{ transform:scale(2.6); opacity:0; }
  }
  @keyframes fade-in-up{
    from{ opacity:0; transform:translateY(6px); }
    to{ opacity:1; transform:translateY(0); }
  }
  .fade-in{ animation:fade-in-up .4s cubic-bezier(.2,.8,.2,1) both; }
</style>
</head>
<body>
<div class="shell">

  <header class="top">
    <div class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="#04120f" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2 L14 9 L21 8 L15 13 L18 21 L12 17 L6 21 L9 13 L3 8 L10 9 Z"/>
        </svg>
      </div>
      <div>
        <h1>GroundLink</h1>
        <p>Real-Time Adaptive Drone Mission Planner — Flight Replay</p>
      </div>
    </div>
    <div class="top-right">
      <div class="badge"><span class="dot"></span> Recorded SITL flight data</div>
      <div class="badge">40 trials · 8 conditions</div>
    </div>
  </header>

  <div class="tabs" id="tabs"></div>

  <div class="grid">
    <div class="main-col">
      <div class="card map-wrap">
        <div class="card-head">
          <div>
            <h2 id="scenarioTitle">—</h2>
          </div>
          <div class="sub" id="scenarioMeta">—</div>
        </div>
        <div class="map-svg-holder">
          <svg class="map" id="mapSvg" viewBox="0 0 1000 640" preserveAspectRatio="xMidYMid meet"></svg>
        </div>
        <div class="legend" id="legend"></div>
        <div class="playback">
          <div class="playback-row">
            <button class="play-btn" id="playBtn">
              <svg id="playIcon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <input type="range" id="scrub" min="0" max="1000" value="0">
            <div class="time-read" id="timeRead">0.0s / 0.0s</div>
          </div>
          <div class="speed-row" id="speedRow"></div>
        </div>
        <div class="telemetry">
          <div class="cell"><div class="label">Altitude</div><div class="value" id="telAlt">—</div></div>
          <div class="cell"><div class="label">Flight Mode</div><div class="value" id="telMode">—</div></div>
          <div class="cell"><div class="label">Elapsed</div><div class="value" id="telTime">—</div></div>
          <div class="cell"><div class="label">Status</div><div class="value" id="telStatus">—</div></div>
        </div>
      </div>

      <div class="card overview">
        <div class="card-head">
          <div>
            <h2>Adaptive vs. Baseline — All Scenarios</h2>
            <p class="desc">5 trials per condition, live PX4 SITL, identical injected failures</p>
          </div>
          <div class="sub">evaluation/RESULTS.md</div>
        </div>
        <div class="bars" id="overviewBars"></div>
      </div>
    </div>

    <div class="side">
      <div class="card">
        <div class="card-head"><h2>Scenario</h2></div>
        <div class="scenario-blurb" id="scenarioBlurb">—</div>
      </div>

      <div class="card">
        <div class="card-head"><h2>Replan Timeline</h2></div>
        <div class="event-log" id="eventLog"></div>
      </div>

      <div class="card">
        <div class="card-head"><h2>Measured Result</h2></div>
        <div class="stat-group" id="statGroup"></div>
      </div>
    </div>
  </div>

  <footer class="foot">
    <span>GroundLink — Team 11 · Autonomous Drones</span>
    <span>Replay of real recorded PX4 SITL telemetry — no live flight-controller connection</span>
  </footer>
</div>

<script>
const DATA = __FLIGHT_DATA__;

/* ---------------------------------------------------------------------- */
/* geo helpers -- equirectangular local-meters projection, same approach  */
/* as mission_planner/geo.py, so the drawn geometry matches the real one  */
/* ---------------------------------------------------------------------- */
const R_EARTH = 6371000.0;
function toLocalXY(lat, lon, originLat, originLon){
  const dLat = lat - originLat;
  const dLon = lon - originLon;
  const y = dLat * (Math.PI/180) * R_EARTH;
  const x = dLon * (Math.PI/180) * R_EARTH * Math.cos(originLat * Math.PI/180);
  return [x, y];
}

const SCENARIOS = [
  { key:'no_fly_zone', label:'No-Fly Zone', short:'NFZ',
    blurb:'A no-fly zone is announced mid-flight, straddling one row of a coverage sweep. <b>GroundLink detects the block, computes a detour around the zone, and continues the mission</b> — rather than aborting. The baseline system instead falls back to a blind return-to-launch, abandoning the remaining sweep.' },
  { key:'battery_critical', label:'Battery Critical', short:'Battery',
    blurb:'Battery drains toward a critical threshold mid-mission. <b>GroundLink detects the crossing via live telemetry and commands return-to-launch</b>, monitored through to a confirmed landing and disarm — not just a mode switch. Under a more severe drain, GroundLink instead lands immediately rather than risking an RTL that may not complete in time.' },
  { key:'gps_degraded', label:'GPS Degraded', short:'GPS',
    blurb:'GPS fix drops to NO_FIX mid-cruise (simulated satellite dropout). <b>GroundLink holds position immediately</b> rather than trying to navigate on an unreliable fix. The baseline&#39;s blind "always RTL" policy fails outright here — RTL depends on the very GPS fix that just broke.' },
];

let current = null;      // active scenario data object
let originLatLon = null;
let playing = false;
let playT = 0;            // seconds, real scenario time
let speedMult = 8;
let lastFrameTs = null;
let maxT = 1;
let projected = null;     // cached projection for current scenario
let rafId = null;

/* ---------------------------------------------------------------------- */
/* tabs                                                                    */
/* ---------------------------------------------------------------------- */
const tabsEl = document.getElementById('tabs');
SCENARIOS.forEach((s, i) => {
  const btn = document.createElement('button');
  btn.className = 'tab';
  btn.dataset.key = s.key;
  btn.innerHTML = `<span>${s.label}</span>`;
  btn.addEventListener('click', () => selectScenario(s.key));
  tabsEl.appendChild(btn);
});
const indicator = document.createElement('div');
indicator.className = 'tab-indicator';
tabsEl.insertBefore(indicator, tabsEl.firstChild);

function positionIndicator(btn){
  const tabsRect = tabsEl.getBoundingClientRect();
  const r = btn.getBoundingClientRect();
  indicator.style.left = (r.left - tabsRect.left) + 'px';
  indicator.style.width = r.width + 'px';
}

/* ---------------------------------------------------------------------- */
/* projection + static geometry per scenario                              */
/* ---------------------------------------------------------------------- */
const VB_W = 1000, VB_H = 640, PAD = 70;

function buildProjection(sc){
  const [oLat, oLon] = sc.home;
  const pts = [];
  sc.mission.forEach(wp => pts.push(toLocalXY(wp.lat, wp.lon, oLat, oLon)));
  sc.series.forEach(p => pts.push(toLocalXY(p.lat, p.lon, oLat, oLon)));
  if (sc.zone_boundary) sc.zone_boundary.forEach(([lat,lon]) => pts.push(toLocalXY(lat, lon, oLat, oLon)));
  if (sc.replanned_waypoints) sc.replanned_waypoints.forEach(wp => pts.push(toLocalXY(wp.lat, wp.lon, oLat, oLon)));

  let minX=Infinity, maxX=-Infinity, minY=Infinity, maxY=-Infinity;
  pts.forEach(([x,y]) => { minX=Math.min(minX,x); maxX=Math.max(maxX,x); minY=Math.min(minY,y); maxY=Math.max(maxY,y); });
  const spanX = Math.max(maxX-minX, 10), spanY = Math.max(maxY-minY, 10);
  const availW = VB_W - PAD*2, availH = VB_H - PAD*2;
  const scale = Math.min(availW/spanX, availH/spanY);
  const cx = (minX+maxX)/2, cy = (minY+maxY)/2;

  function proj([x,y]){
    const sx = VB_W/2 + (x - cx) * scale;
    const sy = VB_H/2 - (y - cy) * scale;   // flip Y: north (lat+) is up
    return [sx, sy];
  }
  return { proj, scale, oLat, oLon };
}

function seriesAtTime(series, t){
  // linear interpolation between the two bracketing samples
  if (t <= series[0].t) return series[0];
  if (t >= series[series.length-1].t) return series[series.length-1];
  for (let i=0; i<series.length-1; i++){
    const a = series[i], b = series[i+1];
    if (t >= a.t && t <= b.t){
      const f = (b.t - a.t) < 1e-6 ? 0 : (t - a.t) / (b.t - a.t);
      return {
        t, lat: a.lat + (b.lat-a.lat)*f, lon: a.lon + (b.lon-a.lon)*f,
        alt: a.alt + (b.alt-a.alt)*f, mode: (f < 0.5 ? a.mode : b.mode),
      };
    }
  }
  return series[series.length-1];
}

/* ---------------------------------------------------------------------- */
/* SVG drawing                                                             */
/* ---------------------------------------------------------------------- */
const svg = document.getElementById('mapSvg');
const NS = 'http://www.w3.org/2000/svg';
function el(tag, attrs){
  const e = document.createElementNS(NS, tag);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  return e;
}

let flownPathEl, droneEl, droneGlowEl, triggerMarkerEl, headingEl;

function drawScenario(sc){
  svg.innerHTML = '';
  const P = buildProjection(sc);
  projected = P;

  // ---- background grid + distance rings from home ----
  const gridLayer = el('g', {});
  const [hx, hy] = P.proj(toLocalXY(sc.home[0], sc.home[1], sc.home[0], sc.home[1]));
  for (let gx = 0; gx <= VB_W; gx += 40) gridLayer.appendChild(el('line', {x1:gx,y1:0,x2:gx,y2:VB_H, stroke:'#131a26', 'stroke-width':1}));
  for (let gy = 0; gy <= VB_H; gy += 40) gridLayer.appendChild(el('line', {x1:0,y1:gy,x2:VB_W,y2:gy, stroke:'#131a26', 'stroke-width':1}));
  [80,160,240].forEach(rm => {
    const rr = rm * P.scale;
    gridLayer.appendChild(el('circle', {cx:hx, cy:hy, r:rr, fill:'none', stroke:'#182035', 'stroke-width':1, 'stroke-dasharray':'3 5'}));
    const lbl = el('text', {x:hx+6, y:hy-rr+12, fill:'#3a4358', 'font-size':9, 'font-family':'var(--mono)'});
    lbl.textContent = rm + 'm';
    gridLayer.appendChild(lbl);
  });
  svg.appendChild(gridLayer);

  // compass
  const compass = el('g', { transform:`translate(${VB_W-46},46)` });
  compass.appendChild(el('circle', {r:20, fill:'#10141d', stroke:'#232a38', 'stroke-width':1}));
  compass.appendChild(el('line', {x1:0,y1:10,x2:0,y2:-12, stroke:'#5b6577', 'stroke-width':1.4}));
  compass.appendChild(el('path', {d:'M 0 -14 L -4 -7 L 4 -7 Z', fill:'#8b96a8'}));
  const nlbl = el('text', {x:0, y:-18, fill:'#6c7690', 'font-size':10, 'text-anchor':'middle', 'font-family':'var(--mono)'});
  nlbl.textContent = 'N';
  compass.appendChild(nlbl);
  svg.appendChild(compass);

  // ---- no-fly zone polygon ----
  if (sc.zone_boundary && sc.zone_boundary.length){
    const zpts = sc.zone_boundary.map(([lat,lon]) => P.proj(toLocalXY(lat, lon, sc.home[0], sc.home[1])));
    const zone = el('polygon', {
      points: zpts.map(p=>p.join(',')).join(' '),
      fill:'rgba(255,97,97,.10)', stroke:'var(--red)', 'stroke-width':1.6, 'stroke-dasharray':'5 4',
    });
    svg.appendChild(zone);
    const zc = zpts.reduce((a,p)=>[a[0]+p[0]/zpts.length, a[1]+p[1]/zpts.length], [0,0]);
    const zlabel = el('text', {x:zc[0], y:zc[1], fill:'#ff8a8a', 'font-size':10.5, 'text-anchor':'middle', 'font-family':'var(--mono)', 'font-weight':600});
    zlabel.textContent = 'NO-FLY ZONE';
    svg.appendChild(zlabel);
  }

  // ---- planned path (original mission waypoints) ----
  const missionPts = sc.mission.map(wp => P.proj(toLocalXY(wp.lat, wp.lon, sc.home[0], sc.home[1])));
  const planned = el('polyline', {
    points: missionPts.map(p=>p.join(',')).join(' '),
    fill:'none', stroke:'var(--amber)', 'stroke-width':2, 'stroke-dasharray':'2 6', 'stroke-linecap':'round', opacity:.85,
  });
  svg.appendChild(planned);
  sc.mission.forEach((wp,i) => {
    const [x,y] = missionPts[i];
    const r = el('circle', {cx:x, cy:y, r: wp.kind==='TAKEOFF'?5:4, fill:'#0d1119', stroke:'var(--amber)', 'stroke-width':1.6});
    svg.appendChild(r);
  });

  // ---- replanned detour path (nfz only) ----
  if (sc.replanned_waypoints && sc.replanned_waypoints.length){
    const rpts = sc.replanned_waypoints.map(wp => P.proj(toLocalXY(wp.lat, wp.lon, sc.home[0], sc.home[1])));
    const detour = el('polyline', {
      points: rpts.map(p=>p.join(',')).join(' '),
      fill:'none', stroke:'var(--violet)', 'stroke-width':2.2, 'stroke-dasharray':'1 0', 'stroke-linecap':'round', opacity:.9,
    });
    svg.appendChild(detour);
  }

  // home marker
  const home = el('g', {transform:`translate(${hx},${hy})`});
  home.appendChild(el('circle', {r:7, fill:'#0d1119', stroke:'var(--text-0)', 'stroke-width':1.6}));
  home.appendChild(el('circle', {r:2, fill:'var(--text-0)'}));
  svg.appendChild(home);

  // ---- actual flown path (progressive) ----
  flownPathEl = el('polyline', { points:'', fill:'none', stroke:'var(--cyan)', 'stroke-width':3, 'stroke-linecap':'round', 'stroke-linejoin':'round', filter:'url(#glow)' });
  svg.appendChild(flownPathEl);

  // glow filter
  const defs = el('defs', {});
  const filt = el('filter', {id:'glow', x:'-50%', y:'-50%', width:'200%', height:'200%'});
  filt.appendChild(el('feGaussianBlur', {stdDeviation:'2.2', result:'blur'}));
  const merge = el('feMerge', {});
  merge.appendChild(el('feMergeNode', {in:'blur'}));
  merge.appendChild(el('feMergeNode', {in:'SourceGraphic'}));
  filt.appendChild(merge);
  defs.appendChild(filt);
  svg.appendChild(defs);

  // trigger marker (hidden until playback reaches it)
  triggerMarkerEl = el('g', {opacity:0});
  const pulse = el('circle', {r:8, fill:'none', stroke:'var(--amber)', 'stroke-width':2});
  pulse.style.transformOrigin = 'center';
  pulse.style.animation = 'pulse-ring 1.6s ease-out infinite';
  triggerMarkerEl.appendChild(pulse);
  triggerMarkerEl.appendChild(el('circle', {r:5, fill:'var(--amber)'}));
  const tlabel = el('text', {y:-14, fill:'var(--amber)', 'font-size':10.5, 'text-anchor':'middle', 'font-family':'var(--mono)', 'font-weight':700});
  tlabel.textContent = 'REPLAN';
  triggerMarkerEl.appendChild(tlabel);
  svg.appendChild(triggerMarkerEl);

  // drone marker
  droneGlowEl = el('circle', {r:11, fill:'var(--cyan)', opacity:.18});
  svg.appendChild(droneGlowEl);
  droneEl = el('g', {});
  headingEl = el('path', {d:'M 0 -8 L 5.5 6 L 0 3 L -5.5 6 Z', fill:'var(--cyan)', stroke:'#04120f', 'stroke-width':.6});
  droneEl.appendChild(headingEl);
  svg.appendChild(droneEl);
}

function updateFrame(){
  const sc = current;
  const pt = seriesAtTime(sc.series, playT);
  const [x,y] = projected.proj(toLocalXY(pt.lat, pt.lon, sc.home[0], sc.home[1]));

  // progressive flown path up to playT
  const shown = sc.series.filter(p => p.t <= playT);
  let ptsStr = shown.map(p => {
    const [px,py] = projected.proj(toLocalXY(p.lat, p.lon, sc.home[0], sc.home[1]));
    return px+','+py;
  }).join(' ');
  ptsStr += (ptsStr ? ' ' : '') + x + ',' + y;
  flownPathEl.setAttribute('points', ptsStr);

  // heading from last small delta
  let heading = 0;
  const idx = Math.max(0, shown.length-1);
  if (shown.length){
    const prev = shown.length>1 ? shown[shown.length-2] : shown[shown.length-1];
    const [px,py] = projected.proj(toLocalXY(prev.lat, prev.lon, sc.home[0], sc.home[1]));
    const dx = x-px, dy = y-py;
    if (Math.hypot(dx,dy) > 0.4) heading = Math.atan2(dx, -dy) * 180/Math.PI;
  }
  droneEl.setAttribute('transform', `translate(${x},${y}) rotate(${heading})`);
  droneGlowEl.setAttribute('cx', x); droneGlowEl.setAttribute('cy', y);

  // trigger marker
  if (sc.t_replan_trigger != null){
    const tp = seriesAtTime(sc.series, sc.t_replan_trigger);
    const [tx,ty] = projected.proj(toLocalXY(tp.lat, tp.lon, sc.home[0], sc.home[1]));
    triggerMarkerEl.setAttribute('transform', `translate(${tx},${ty})`);
    triggerMarkerEl.setAttribute('opacity', playT >= sc.t_replan_trigger ? 1 : 0);
  }

  // telemetry strip
  document.getElementById('telAlt').textContent = pt.alt.toFixed(1) + ' m';
  const modeEl = document.getElementById('telMode');
  modeEl.textContent = pt.mode || '—';
  modeEl.className = 'value' + (pt.mode ? ' mode-'+pt.mode : '');
  document.getElementById('telTime').textContent = playT.toFixed(1) + ' s';
  document.getElementById('telStatus').textContent = statusForTime(sc, playT);

  document.getElementById('timeRead').textContent = `${playT.toFixed(1)}s / ${maxT.toFixed(1)}s`;
  document.getElementById('scrub').value = Math.round((playT/maxT)*1000);

  updateEventLog(sc, playT);
}

function statusForTime(sc, t){
  if (sc.t_replan_trigger == null) return 'Nominal';
  if (t < sc.t_replan_trigger) return 'Nominal';
  return 'Replanning';
}

/* ---------------------------------------------------------------------- */
/* event log                                                               */
/* ---------------------------------------------------------------------- */
function buildEvents(sc){
  const events = [{ t:0, text:'Mission uploaded — climbing to cruise altitude', trigger:false }];
  if (sc.scenario === 'no_fly_zone'){
    events.push({ t: sc.t_replan_trigger, text:`No-fly zone announced — engine reroutes around it (<b>${sc.event_outcome}</b>)`, trigger:true });
    if (sc.t_to_mission_end_s != null) events.push({ t: sc.t_replan_trigger + sc.t_to_mission_end_s, text:'Coverage sweep completed via detour', trigger:false });
  } else if (sc.scenario === 'battery_critical'){
    events.push({ t: sc.t_replan_trigger, text:`Battery critical: <b>${sc.detected_percent}%</b> remaining — <b>${sc.event_outcome}</b> commanded`, trigger:true });
    if (sc.t_to_safe_recovery_s != null) events.push({ t: sc.t_replan_trigger + sc.t_to_safe_recovery_s, text:'Vehicle confirmed safe — disarmed', trigger:false });
  } else if (sc.scenario === 'gps_degraded'){
    events.push({ t: sc.t_replan_trigger, text:`GPS fix lost (<b>${sc.detected_fix_type}</b>) — <b>${sc.event_outcome}</b> commanded`, trigger:true });
    if (sc.t_to_safe_recovery_s != null) events.push({ t: sc.t_replan_trigger + sc.t_to_safe_recovery_s, text:'Vehicle confirmed stopped and holding', trigger:false });
  }
  return events;
}

function updateEventLog(sc, t){
  const log = document.getElementById('eventLog');
  const events = sc.__events;
  let activeIdx = 0;
  events.forEach((e,i) => { if (t >= e.t) activeIdx = i; });
  [...log.children].forEach((child, i) => {
    child.classList.toggle('active', i === activeIdx);
    child.classList.toggle('past', i < activeIdx);
  });
}

function renderEventLog(sc){
  const log = document.getElementById('eventLog');
  log.innerHTML = '';
  sc.__events.forEach((e, i) => {
    const row = document.createElement('div');
    row.className = 'event' + (e.trigger ? ' trigger' : '');
    row.innerHTML = `
      <div class="event-time">${e.t.toFixed(1)}s</div>
      <div class="event-dot-col"><div class="event-dot"></div>${i < sc.__events.length-1 ? '<div class="event-line"></div>' : ''}</div>
      <div class="event-text">${e.text}</div>`;
    log.appendChild(row);
  });
}

/* ---------------------------------------------------------------------- */
/* stat cards + legend                                                    */
/* ---------------------------------------------------------------------- */
function num(str){ const m = /(-?\d+(\.\d+)?)/.exec(str||''); return m ? parseFloat(m[1]) : null; }

function renderStats(sc){
  const grp = document.getElementById('statGroup');
  grp.innerHTML = '';

  function compareBlock(title, compKey){
    const c = DATA.comparison[compKey];
    if (!c) return;
    const wrap = document.createElement('div');
    wrap.className = 'fade-in';
    wrap.innerHTML = `<div class="stat-group-title">${title}</div>`;
    const row = document.createElement('div');
    row.className = 'compare-row';
    ['adaptive','baseline'].forEach(cond => {
      const d = c[cond];
      const card = document.createElement('div');
      card.className = 'compare-card ' + cond;
      card.innerHTML = `
        <div class="tag">${cond}</div>
        <div class="compare-metric"><div class="k">Completion</div><div class="v">${d.completion.split(' (')[0]}%</div></div>
        <div class="compare-metric"><div class="k">Recovery time</div><div class="v">${d.recovery_time.split(' (')[0]}${/n\/a/.test(d.recovery_time)?'':'s'}</div></div>
        <div class="compare-metric"><div class="k">Safe-confirmed</div><div class="v">${d.safe_rate}</div></div>`;
      row.appendChild(card);
    });
    wrap.appendChild(row);
    grp.appendChild(wrap);
  }

  if (sc.scenario === 'no_fly_zone'){
    compareBlock('No-Fly Zone — Coverage Mission', 'no-fly-zone (coverage mission)');
    const pill = document.createElement('div');
    pill.className = 'headline-pill fade-in';
    pill.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
      <span>Adaptive completes <b>83.3%</b> of the mission vs. baseline's <b>50.0%</b> — zone never entered in either condition.</span>`;
    grp.appendChild(pill);
  } else if (sc.scenario === 'battery_critical'){
    compareBlock('Battery — Moderate (12%)', 'battery-critical (moderate, 12%)');
    compareBlock('Battery — Severe (~5%)', 'battery-critical (severe, ~5%)');
    const pill = document.createElement('div');
    pill.className = 'headline-pill fade-in';
    pill.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 7 13h5l-1 9 8-13h-6l2-7z"/></svg>
      <span>Under a severe drain, adaptive lands in <b>19.8s</b> vs. baseline's full RTL at <b>51.3s</b> — <b>2.6&times; faster</b>.</span>`;
    grp.appendChild(pill);
  } else if (sc.scenario === 'gps_degraded'){
    compareBlock('GPS Degradation', 'gps-degradation');
    const pill = document.createElement('div');
    pill.className = 'headline-pill fade-in';
    pill.style.background = 'linear-gradient(135deg, rgba(255,97,97,.13), rgba(255,97,97,.04))';
    pill.style.borderColor = 'rgba(255,97,97,.28)';
    pill.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="#ff6161" stroke-width="2"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
      <span style="color:#ffb3b3"><b style="color:#ff8a8a">Baseline fails outright here:</b> RTL is accepted by PX4 but overridden to LAND by its own failsafe within ~5s — <b style="color:#ff8a8a">0 of 5</b> baseline trials safely returned.</span>`;
    grp.appendChild(pill);
  }
}

function renderLegend(sc){
  const legend = document.getElementById('legend');
  const items = [
    { swatch:'dashed', color:'var(--amber)', label:'Planned mission path' },
    { swatch:'solid', color:'var(--cyan)', label:'Actual flown path (adaptive)' },
  ];
  if (sc.replanned_waypoints && sc.replanned_waypoints.length) items.push({ swatch:'solid', color:'var(--violet)', label:'Replanned detour' });
  if (sc.zone_boundary && sc.zone_boundary.length) items.push({ swatch:'dot', color:'var(--red)', label:'No-fly zone' });
  items.push({ swatch:'dot', color:'var(--amber)', label:'Replan trigger' });
  legend.innerHTML = items.map(it => `
    <div class="legend-item">
      ${it.swatch === 'dot'
        ? `<div class="legend-dot" style="background:${it.color}"></div>`
        : `<div class="legend-swatch ${it.swatch==='dashed'?'dashed':''}" style="${it.swatch==='dashed'?`color:${it.color}`:`background:${it.color}`}"></div>`}
      <span>${it.label}</span>
    </div>`).join('');
}

/* ---------------------------------------------------------------------- */
/* overview bars (bottom, all scenarios)                                  */
/* ---------------------------------------------------------------------- */
function renderOverview(){
  const wrap = document.getElementById('overviewBars');
  wrap.innerHTML = '';

  function block(title, sub, compKey, metricFn, unit, maxVal){
    const c = DATA.comparison[compKey];
    const a = metricFn(c.adaptive), b = metricFn(c.baseline);
    const div = document.createElement('div');
    div.className = 'bar-block';
    div.innerHTML = `
      <div class="bar-title">${title}</div>
      <div class="bar-sub">${sub}</div>
      <div class="bar-line">
        <div class="bl-label">Adaptive</div>
        <div class="bl-track"><div class="bl-fill adaptive" data-w="${(a==null?0:Math.min(100,(a/maxVal)*100))}"></div></div>
        <div class="bl-val">${a==null?'—':a+unit}</div>
      </div>
      <div class="bar-line">
        <div class="bl-label">Baseline</div>
        <div class="bl-track"><div class="bl-fill baseline" data-w="${(b==null?0:Math.min(100,(b/maxVal)*100))}"></div></div>
        <div class="bl-val">${b==null?'—':b+unit}</div>
      </div>`;
    wrap.appendChild(div);
  }

  block('Mission Completion', 'No-fly-zone coverage mission', 'no-fly-zone (coverage mission)', d => num(d.completion), '%', 100);
  block('Recovery Speed', 'Battery critical, severe (~5%)', 'battery-critical (severe, ~5%)', d => num(d.recovery_time), 's', 60);
  block('Safe Recovery Rate', 'GPS degradation (of 5 trials)', 'gps-degradation', d => { const m = /(\d)\/(\d)/.exec(d.safe_rate); return m ? parseInt(m[1]) : null; }, '/5', 5);

  requestAnimationFrame(() => {
    setTimeout(() => {
      wrap.querySelectorAll('.bl-fill').forEach(f => { f.style.width = f.dataset.w + '%'; });
    }, 60);
  });
}

/* ---------------------------------------------------------------------- */
/* playback loop                                                          */
/* ---------------------------------------------------------------------- */
function tick(ts){
  if (!playing){ lastFrameTs = null; return; }
  if (lastFrameTs == null) lastFrameTs = ts;
  const dt = (ts - lastFrameTs)/1000;
  lastFrameTs = ts;
  playT = Math.min(maxT, playT + dt*speedMult);
  updateFrame();
  if (playT >= maxT){ playing = false; setPlayIcon(false); return; }
  rafId = requestAnimationFrame(tick);
}

function setPlayIcon(isPlaying){
  const icon = document.getElementById('playIcon');
  icon.innerHTML = isPlaying
    ? '<path d="M7 5h4v14H7zM13 5h4v14h-4z"/>'
    : '<path d="M8 5v14l11-7z"/>';
}

document.getElementById('playBtn').addEventListener('click', () => {
  playing = !playing;
  setPlayIcon(playing);
  if (playing){
    if (playT >= maxT) playT = 0;
    lastFrameTs = null;
    rafId = requestAnimationFrame(tick);
  }
});

document.getElementById('scrub').addEventListener('input', (e) => {
  playing = false; setPlayIcon(false);
  playT = (e.target.value/1000) * maxT;
  updateFrame();
});

const speedRow = document.getElementById('speedRow');
[2,4,8,16].forEach(mult => {
  const b = document.createElement('button');
  b.className = 'speed-btn' + (mult===speedMult?' active':'');
  b.textContent = mult+'×';
  b.addEventListener('click', () => {
    speedMult = mult;
    [...speedRow.children].forEach(c=>c.classList.remove('active'));
    b.classList.add('active');
  });
  speedRow.appendChild(b);
});

/* ---------------------------------------------------------------------- */
/* scenario selection                                                     */
/* ---------------------------------------------------------------------- */
function selectScenario(key){
  playing = false; setPlayIcon(false); playT = 0;
  const meta = SCENARIOS.find(s => s.key === key);
  current = DATA.scenarios[key];
  current.__events = buildEvents(current);
  maxT = current.series[current.series.length-1].t;

  document.getElementById('scenarioTitle').textContent = meta.label;
  document.getElementById('scenarioMeta').textContent = `${current.series.length} telemetry samples · ${maxT.toFixed(0)}s flight`;
  document.getElementById('scenarioBlurb').innerHTML = meta.blurb;

  [...tabsEl.querySelectorAll('.tab')].forEach(t => {
    const active = t.dataset.key === key;
    t.classList.toggle('active', active);
    if (active) positionIndicator(t);
  });

  drawScenario(current);
  renderLegend(current);
  renderEventLog(current);
  renderStats(current);
  updateFrame();
}

renderOverview();
window.addEventListener('resize', () => {
  const activeTab = tabsEl.querySelector('.tab.active');
  if (activeTab) positionIndicator(activeTab);
});
selectScenario('no_fly_zone');
</script>
</body>
</html>
